# Copy to .env and fill in real values. Never commit the real .env.

# --- Database (full/grove stack — see docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://kintsugi:kintsugi@localhost:5432/kintsugi

# --- Required for any LLM-calling code path (AnthropicClient) ---
# Preferred: a long-lived OAuth token from `claude setup-token` (requires a
# Claude Pro/Max/Team/Enterprise subscription). Verified working with the
# standalone anthropic SDK via auth_token= this session. Takes precedence
# over ANTHROPIC_API_KEY below when both are set.
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback: a standard Console API key. Used only if CLAUDE_CODE_OAUTH_TOKEN
# is unset. Every request fails at call time if neither is configured.
ANTHROPIC_API_KEY=

# --- Optional: OpenAI embeddings instead of local sentence-transformers ---
OPENAI_API_KEY=

# --- Deployment tier: seed (SQLite, laptop) | sprout | grove (full stack) ---
DEPLOYMENT_TIER=sprout

# --- Redis (used by Celery for background tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Memory: temporal tree (h-mem-temporal) — local SQLite, no Postgres needed ---
TEMPORAL_TREE_DB_PATH=temporal_tree.db

# --- Memory: knowledge graph entity extraction model ---
KG_SPACY_MODEL=en_core_web_md
